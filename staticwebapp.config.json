{
  "routes": [
    {
      "route": "/*",
      "serve": "/index.html",
      "statusCode": 200
    },
    {
      "route": "/bulk-actions",
      "serve": "/bulk-actions/index.html"
    },
    {
      "route": "/bulk-actions/*",
      "serve": "/bulk-actions/index.html"
    },
    {
      "route": "/schedule",
      "serve": "/schedule/index.html"
    },
    {
      "route": "/schedule/*",
      "serve": "/schedule/index.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html"
  },
  "mimeTypes": {
    ".json": "application/json",
    ".wasm": "application/wasm"
  }
}
